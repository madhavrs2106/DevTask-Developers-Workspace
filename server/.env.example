# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devtask?schema=public"

# Express API
PORT=5000
NODE_ENV=development

# Auth — use a long random string in production (e.g. `openssl rand -hex 48`)
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"

# Allowed CORS origins (comma separated)
CLIENT_ORIGIN="http://localhost:5173"
