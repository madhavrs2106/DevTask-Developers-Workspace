// DevTask — Prisma schema (PostgreSQL)
// Models: User, Project, Course, Task, SkillProgress, CodingSession

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  DEVELOPER
  LEARNER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum TaskStatus {
  BACKLOG
  IN_PROGRESS
  REVIEW
  DONE
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  username     String          @unique
  passwordHash String
  name         String
  role         Role            @default(DEVELOPER)
  bio          String?
  avatarColor  String          @default("#06B6D4")
  avatarUrl    String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tasks          Task[]
  projects       Project[]
  courses        Course[]
  skills         SkillProgress[]
  codingSessions CodingSession[]
  following      Follow[] @relation("follower")
  followers      Follow[] @relation("following")

  createdRooms     CoLearningRoom[]
  roomMemberships  RoomMember[]
  roomResources    RoomResource[]
  roomDiscussions  RoomDiscussion[]
  focusSessions    FocusSession[]
  syllabusCompletions RoomSyllabusCompletion[]
  roomNotes        RoomNote[]
}

model Follow {
  id         String   @id @default(cuid())
  followerId String
  followingId String
  createdAt  DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id])
  following User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  repoUrl     String?
  color       String   @default("#06B6D4")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Course {
  id             String   @id @default(cuid())
  title          String
  provider       String?
  category       String?
  description    String?
  totalLessons   Int      @default(0)
  lessonsDone    Int      @default(0)
  estimatedHours Int      @default(0)
  status         String   @default("IN_PROGRESS") // NOT_STARTED | IN_PROGRESS | COMPLETED
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(BACKLOG)
  difficulty  Difficulty @default(BEGINNER)
  tags        String[]   @default([])
  codeSnippet String?
  snippetLang String?
  githubUrl   String?
  dueDate     DateTime?
  position    Float      @default(0)
  actualHours Float      @default(0)
  completedAt DateTime?
  projectId   String?
  courseId    String?
  userId      String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([projectId])
  @@index([courseId])
}

model SkillProgress {
  id        String @id @default(cuid())
  name      String
  level     Int    @default(0) // mastery 0-100
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model CodingSession {
  id     String   @id @default(cuid())
  date   DateTime @default(now())
  hours  Float    @default(0)
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ─── Co-Learning Rooms ─────────────────────────────────────────────

model CoLearningRoom {
  id              String   @id @default(cuid())
  name            String
  topic           String
  inviteCode      String   @unique
  description     String?
  visibility      String   @default("PUBLIC") // PUBLIC | PRIVATE
  passwordHash    String?
  streakCount     Int      @default(0)
  lastStreakDate  DateTime?
  maxMembers      Int      @default(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator   User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  members        RoomMember[]
  syllabusItems  RoomSyllabusItem[]
  resources      RoomResource[]
  discussions    RoomDiscussion[]
  focusSessions  FocusSession[]
  streaks        RoomStreak[]
  notes          RoomNote[]

  @@index([creatorId])
  @@index([inviteCode])
}

model RoomMember {
  id       String   @id @default(cuid())
  role     String   @default("MEMBER") // ADMIN | MEMBER
  joinedAt DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  @@unique([userId, roomId])
  @@index([roomId])
}

model RoomSyllabusItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  resourceUrl String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  completions RoomSyllabusCompletion[]
  discussions RoomDiscussion[]

  @@index([roomId])
}

model RoomSyllabusCompletion {
  id        String   @id @default(cuid())
  completedAt DateTime @default(now())

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  item   RoomSyllabusItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  @@unique([userId, itemId])
  @@index([itemId])
}

model RoomResource {
  id          String   @id @default(cuid())
  title       String
  url         String
  type        String   @default("LINK") // LINK | NOTE | REPO | VIDEO
  description String?
  path        String   @default("") // folder path like "docs/", "src/utils/"
  createdAt   DateTime @default(now())

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
  addedBy User          @relation(fields: [addedByUserId], references: [id], onDelete: Cascade)
  addedByUserId String

  @@index([roomId])
}

model RoomDiscussion {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String
  syllabusItem RoomSyllabusItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId String?
  parent   RoomDiscussion? @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  replies  RoomDiscussion[] @relation("DiscussionReplies")

  @@index([roomId])
  @@index([itemId])
  @@index([parentId])
}

model FocusSession {
  id        String   @id @default(cuid())
  task      String
  duration  Int      @default(25) // minutes
  status    String   @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  startedAt DateTime @default(now())
  endsAt    DateTime

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([roomId])
  @@index([userId])
}

model RoomStreak {
  id       String   @id @default(cuid())
  date     DateTime @db.Date
  membersActive Int @default(0)
  targetMet Boolean @default(false)

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  @@unique([roomId, date])
  @@index([roomId])
}

model RoomNote {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("FOLDER") // FOLDER | FILE
  fileType  String?  // TEXT | CODE | IMAGE | VIDEO | DOC
  content   String?  // text for TEXT/CODE, URL for IMAGE/VIDEO/DOC
  fileName  String?  // original filename
  fileSize  Int?     // bytes
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  parent   RoomNote?  @relation("NoteChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children RoomNote[] @relation("NoteChildren")

  @@index([roomId])
  @@index([parentId])
}
