// DevTask — SQLite fallback schema (zero-setup local dev).
// Mirrors schema.prisma (PostgreSQL) with two SQLite limitations worked around:
//   1. no native enums        -> statuses/roles/difficulties stored as strings
//   2. no scalar list types   -> Task.tags stored as a JSON-encoded string
//
// Usage:
//   npx prisma generate --schema=prisma/schema.sqlite.prisma
//   npx prisma db push   --schema=prisma/schema.sqlite.prisma
//   npm run db:seed      (with DATABASE_URL="file:./devtask.db")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("DEVELOPER") // DEVELOPER | LEARNER
  bio          String?
  avatarColor  String   @default("#06B6D4")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tasks          Task[]
  projects       Project[]
  courses        Course[]
  skills         SkillProgress[]
  codingSessions CodingSession[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  repoUrl     String?
  color       String   @default("#06B6D4")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Course {
  id             String   @id @default(cuid())
  title          String
  provider       String?
  category       String?
  description    String?
  totalLessons   Int      @default(0)
  lessonsDone    Int      @default(0)
  estimatedHours Int      @default(0)
  status         String   @default("IN_PROGRESS") // NOT_STARTED | IN_PROGRESS | COMPLETED
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("BACKLOG") // BACKLOG | IN_PROGRESS | REVIEW | DONE
  difficulty  String    @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  tags        String    @default("[]") // JSON-encoded string array
  codeSnippet String?
  snippetLang String?
  githubUrl   String?
  dueDate     DateTime?
  position    Float     @default(0)
  actualHours Float     @default(0)
  completedAt DateTime?
  projectId   String?
  courseId    String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([projectId])
  @@index([courseId])
}

model SkillProgress {
  id     String @id @default(cuid())
  name   String
  level  Int    @default(0) // mastery 0-100
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model CodingSession {
  id     String   @id @default(cuid())
  date   DateTime @default(now())
  hours  Float    @default(0)
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}
