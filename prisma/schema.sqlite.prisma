// DevTask — SQLite fallback schema (zero-setup local dev).
// Mirrors schema.prisma (PostgreSQL) with two SQLite limitations worked around:
//   1. no native enums        -> statuses/roles/difficulties stored as strings
//   2. no scalar list types   -> Task.tags stored as a JSON-encoded string
//
// Usage:
//   npx prisma generate --schema=prisma/schema.sqlite.prisma
//   npx prisma db push   --schema=prisma/schema.sqlite.prisma
//   npm run db:seed      (with DATABASE_URL="file:./devtask.db")

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  passwordHash String
  name         String
  role         String   @default("DEVELOPER") // DEVELOPER | LEARNER
  bio          String?
  avatarColor  String          @default("#06B6D4")
  backgroundColor String?
  avatarUrl    String?
  onboarded    Boolean         @default(false) // true once the user finishes the first-time details wizard

  // Resume / academic profile (for the future resume generator) — stored as JSON text
  academicDetails String? // { tenth, twelfth, college }
  contactDetails  String? // { phone, address, city, state, country, pincode, linkedin, github, portfolio }
  resumeExtras    String? // { summary, projects, certifications, achievements, workExperience, languagesKnown, hobbies }

  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  tasks          Task[]
  projects       Project[]
  courses        Course[]
  skills         SkillProgress[]
  codingSessions CodingSession[]
  following      Follow[] @relation("follower")
  followers      Follow[] @relation("following")

  createdRooms     CoLearningRoom[]
  roomMemberships  RoomMember[]
  roomResources    RoomResource[]
  roomDiscussions  RoomDiscussion[]
  focusSessions    FocusSession[]
  syllabusCompletions RoomSyllabusCompletion[]
  roomNotes        RoomNote[]
  quizSubmissions   RoomQuizSubmission[]
  quizLocks         RoomQuizLock[]
  createdQuizzes   RoomQuiz[]
  createdProblems  RoomProblem[]
  roomProblemSubmissions RoomProblemSubmission[]
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("follower", fields: [followerId], references: [id])
  following User @relation("following", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  repoUrl     String?
  techStack   String?   // comma-separated technologies
  color       String   @default("#06B6D4")
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Course {
  id             String   @id @default(cuid())
  title          String
  provider       String?
  category       String?
  description    String?
  totalLessons   Int      @default(0)
  lessonsDone    Int      @default(0)
  estimatedHours Int      @default(0)
  status         String   @default("IN_PROGRESS") // NOT_STARTED | IN_PROGRESS | COMPLETED
  userId         String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([userId])
}

model Task {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("BACKLOG") // BACKLOG | IN_PROGRESS | REVIEW | DONE
  difficulty  String    @default("BEGINNER") // BEGINNER | INTERMEDIATE | ADVANCED
  tags        String    @default("[]") // JSON-encoded string array
  codeSnippet String?
  snippetLang String?
  githubUrl   String?
  dueDate     DateTime?
  position    Float     @default(0)
  actualHours Float     @default(0)
  completedAt DateTime?
  projectId   String?
  courseId    String?
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([projectId])
  @@index([courseId])
}

model SkillProgress {
  id     String @id @default(cuid())
  name   String
  level  Int    @default(0) // mastery 0-100
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@index([userId])
}

model CodingSession {
  id     String   @id @default(cuid())
  date   DateTime @default(now())
  hours  Float    @default(0)
  userId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// ─── Co-Learning Rooms ─────────────────────────────────────────────

model CoLearningRoom {
  id              String   @id @default(cuid())
  name            String
  topic           String
  inviteCode      String   @unique
  description     String?
  visibility      String   @default("PUBLIC") // PUBLIC | PRIVATE
  passwordHash    String?
  streakCount     Int      @default(0)
  lastStreakDate  DateTime?
  maxMembers      Int      @default(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  creator   User          @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  members        RoomMember[]
  syllabusItems  RoomSyllabusItem[]
  resources      RoomResource[]
  discussions    RoomDiscussion[]
  focusSessions  FocusSession[]
  streaks        RoomStreak[]
  notes          RoomNote[]
  quizzes        RoomQuiz[]
  problems       RoomProblem[]

  @@index([creatorId])
  @@index([inviteCode])
}

model RoomMember {
  id       String   @id @default(cuid())
  role     String   @default("MEMBER") // ADMIN | MEMBER
  joinedAt DateTime @default(now())

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  @@unique([userId, roomId])
  @@index([roomId])
}

model RoomSyllabusItem {
  id          String   @id @default(cuid())
  title       String
  description String?
  resourceUrl String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  completions RoomSyllabusCompletion[]
  discussions RoomDiscussion[]

  @@index([roomId])
}

model RoomSyllabusCompletion {
  id        String   @id @default(cuid())
  completedAt DateTime @default(now())

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
  item   RoomSyllabusItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  itemId String

  @@unique([userId, itemId])
  @@index([itemId])
}

model RoomResource {
  id          String   @id @default(cuid())
  title       String
  url         String
  type        String   @default("LINK") // LINK | NOTE | REPO | VIDEO
  description String?
  path        String   @default("") // folder path like "docs/", "src/utils/"
  createdAt   DateTime @default(now())

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
  addedBy User          @relation(fields: [addedByUserId], references: [id], onDelete: Cascade)
  addedByUserId String

  @@index([roomId])
}

model RoomDiscussion {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String
  syllabusItem RoomSyllabusItem? @relation(fields: [itemId], references: [id], onDelete: SetNull)
  itemId String?
  parent   RoomDiscussion? @relation("DiscussionReplies", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  replies  RoomDiscussion[] @relation("DiscussionReplies")

  @@index([roomId])
  @@index([itemId])
  @@index([parentId])
}

model FocusSession {
  id        String   @id @default(cuid())
  task      String
  duration  Int      @default(25) // minutes
  status    String   @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED
  startedAt DateTime @default(now())
  endsAt    DateTime

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([roomId])
  @@index([userId])
}

model RoomStreak {
  id       String   @id @default(cuid())
  date     DateTime
  membersActive Int @default(0)
  targetMet Boolean @default(false)

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String

  @@unique([roomId, date])
  @@index([roomId])
}

model RoomNote {
  id        String   @id @default(cuid())
  title     String
  type      String   @default("FOLDER") // FOLDER | FILE
  fileType  String?  // TEXT | CODE | IMAGE | VIDEO | DOC
  content   String?  // text for TEXT/CODE, URL for IMAGE/VIDEO/DOC
  fileName  String?  // original filename
  fileSize  Int?     // bytes
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room   CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId String
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId String

  parent   RoomNote?  @relation("NoteChildren", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String?
  children RoomNote[] @relation("NoteChildren")

  @@index([roomId])
  @@index([parentId])
}

// ─── Quizzes ────────────────────────────────────────────────────

model RoomQuiz {
  id          String   @id @default(cuid())
  title       String
  description String?
  status      String   @default("DRAFT") // DRAFT | PUBLISHED
  createdAt   DateTime @default(now())

  room      CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId    String
  creator   User           @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  creatorId String

  questions   RoomQuizQuestion[]
  submissions RoomQuizSubmission[]
  locks       RoomQuizLock[]

  @@index([roomId])
}

model RoomQuizQuestion {
  id     String @id @default(cuid())
  text   String
  type   String @default("MCQ") // MCQ | NUMERICAL
  options String? // JSON array of MCQ options, null for NUMERICAL
  answer String // correct answer (MCQ option index or numerical value)
  order  Int    @default(0)

  quiz   RoomQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId String

  @@index([quizId])
}

model RoomQuizSubmission {
  id        String   @id @default(cuid())
  answers   String // JSON: { questionId: answer }
  score     Int? // null until graded
  feedback  String? // admin feedback
  status    String   @default("SUBMITTED") // SUBMITTED | GRADED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  quiz   RoomQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([quizId, userId])
  @@index([quizId])
  @@index([userId])
}

model RoomQuizLock {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  quiz   RoomQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([quizId, userId])
  @@index([quizId])
  @@index([userId])
}

model RoomProblem {
  id          String   @id @default(cuid())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  room        CoLearningRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId      String
  creator     User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  createdById String

  title       String
  description String // problem statement
  difficulty  String @default("EASY") // EASY | MEDIUM | HARD
  languages   String @default("[\"javascript\",\"python\"]") // JSON array of allowed languages
  starterCode String @default("{}") // JSON map language -> starter code
  testCases   String // JSON array of { input, expected, hidden }

  submissions RoomProblemSubmission[]

  @@index([roomId])
  @@index([createdById])
}

model RoomProblemSubmission {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  problem   RoomProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  problemId String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String

  code     String
  language String
  passed   Int    @default(0)
  total    Int    @default(0)
  status   String @default("PENDING") // ACCEPTED | WRONG | TIME_LIMIT | RUNTIME_ERROR
  results  String @default("[]") // JSON array of { input, expected, actual, passed, error }

  @@index([problemId])
  @@index([userId])
  @@index([problemId, userId])
}

model AppSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model KnowledgeItem {
  id        String   @id @default(cuid())
  type      String   @default("FAQ") // FAQ | DOCUMENT
  question  String?
  answer    String // answer text (FAQ) or document body (DOCUMENT)
  title     String?
  createdAt DateTime @default(now())

  @@index([type])
}
