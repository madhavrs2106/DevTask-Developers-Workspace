# Vite environment (client)
# Leave VITE_API_URL empty to use the built-in dev proxy (/api -> http://localhost:5000).
# For production builds, set the full API origin, e.g. https://api.yourdomain.com
VITE_API_URL=""

# Noupe AI chatbot (no-code embeddable widget). Shown only inside the authenticated app.
# Set ONE of the following:
#   VITE_NOUPE_EMBED_SNIPPET = the exact <script ...></script> line from your Noupe dashboard
#   VITE_NOUPE_SCRIPT_SRC + VITE_NOUPE_BOT_ID = build the script tag from these
# Leave all empty to disable the widget.
VITE_NOUPE_EMBED_SNIPPET=""
VITE_NOUPE_SCRIPT_SRC=""
VITE_NOUPE_BOT_ID=""
