# Root environment (copy to .env if you want shared defaults)
# Server-side values live in server/.env — see server/.env.example
# Client-side values live in client/.env — see client/.env.example

# PostgreSQL connection string used by Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devtask?schema=public"

# Express API
PORT=5000
NODE_ENV=development
JWT_SECRET="replace-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
CLIENT_ORIGIN="http://localhost:5173"

# Vite frontend (leave VITE_API_URL empty to use the dev proxy at /api -> :5000)
VITE_API_URL=""
